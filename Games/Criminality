local function makeBtn(label, tag, xPos, color, url)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 130, 0, 90)
	btn.Position = UDim2.new(0, xPos, 0, 50)
	btn.BackgroundColor3 = Color3.fromRGB(15, 19, 32)
	btn.BorderSizePixel = 0
	btn.Text = label
	btn.TextColor3 = color
	btn.TextSize = 22
	btn.Font = Enum.Font.GothamBold
	btn.Parent = frame

	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	local s = Instance.new("UIStroke", btn)
	s.Color = color
	s.Thickness = 1
	s.Transparency = 0.5

	local tagLabel = Instance.new("TextLabel")
	tagLabel.Size = UDim2.new(1, 0, 0, 16)
	tagLabel.Position = UDim2.new(0, 0, 1, -20)
	tagLabel.BackgroundTransparency = 1
	tagLabel.Text = tag
	tagLabel.TextColor3 = Color3.fromRGB(120, 140, 170)
	tagLabel.TextSize = 11
	tagLabel.Font = Enum.Font.Code
	tagLabel.Parent = btn

	btn.MouseEnter:Connect(function()
		s.Transparency = 0
		btn.BackgroundColor3 = Color3.fromRGB(20, 28, 50)
	end)
	btn.MouseLeave:Connect(function()
		s.Transparency = 0.5
		btn.BackgroundColor3 = Color3.fromRGB(15, 19, 32)
	end)
	btn.MouseButton1Click:Connect(function()
		gui:Destroy()
		loadstring(game:HttpGet(url))()
	end)
end

